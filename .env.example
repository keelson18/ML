# Quantum Intelligence — Environment Configuration
# Copy this file to .env and fill in your credentials.

# Supabase Project Configuration
# Get these from your Supabase project dashboard: Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only ML maintenance key (never expose with a VITE_ prefix)
ML_SERVICE_API_KEY=replace-with-a-random-server-secret

# Exact browser origin allowed by authenticated Edge Functions
CORS_ORIGIN=http://localhost:5173

# Google Gemini API Key (for Kinetic Coach)
GEMINI_API_KEY=your-gemini-api-key-here

# Supabase Service Role Key (for edge functions with admin privileges)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
