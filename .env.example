# Quantum Intelligence — Environment Configuration
# Copy this file to .env and fill in your credentials.

# Supabase Project Configuration
# Get these from your Supabase project dashboard: Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Provider keys are server-only; never expose them with a VITE_ prefix.
TWELVEDATA_API_KEY=your-twelvedata-api-key-here
MASSIVE_API_KEY=your-massive-api-key-here
VITE_BACKEND_URL=http://localhost:8787

# Supabase Edge Function runtime only. In local Docker-based Supabase, use a host-reachable URL.
BACKEND_URL=http://host.docker.internal:8787
ML_FUNCTION_ENV=development

# Server-only ML maintenance key (never expose with a VITE_ prefix)
ML_SERVICE_API_KEY=replace-with-a-random-server-secret

# Exact browser origin(s) allowed by the API and Edge Functions (comma-separated). Required in production.
CORS_ORIGIN=http://localhost:5173

# Fastify rate-limit window in milliseconds.
RATE_LIMIT_WINDOW_MS=60000
# Maximum authenticated market requests per user in the configured window.
MARKET_RATE_LIMIT_MAX=60
# Maximum authenticated analysis requests per user in the configured window.
ANALYZE_RATE_LIMIT_MAX=5
# Maximum market-data series retained in the backend in-memory cache.
MARKET_DATA_CACHE_MAX_ENTRIES=500
# Allow stale cache fallback only up to this multiple of the timeframe TTL.
MARKET_DATA_MAX_STALE_TTL_MULTIPLIER=3
# Delay between Massive ticker probes to limit provider request bursts.
MARKET_PROBE_INTERVAL_MS=1000
# Maximum administrative full-universe probes per authenticated admin in the window.
MARKET_PROBE_RATE_LIMIT_MAX=1
# Optional comma-separated verified Massive crypto symbols. Invalid names fail at backend startup.
MARKETS_VERIFIED_OVERRIDE=
# Canonical default instrument; must be an active market in the registry.
DEFAULT_SYMBOL=BTCUSD
# Canonical comma-separated scheduler symbols; defaults to DEFAULT_SYMBOL.
AUTONOMY_SYMBOLS=BTCUSD

# Autonomous paper-trading scheduler. Off unless set to true.
AUTONOMOUS_TRADING=false

# Google Gemini API Key (for Kinetic Coach)
GEMINI_API_KEY=your-gemini-api-key-here

# Supabase Service Role Key (for edge functions with admin privileges)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
