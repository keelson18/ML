# Copy to .env for local development. Never commit .env or expose server-only values with VITE_.
# Runtime mode used for production security headers and provider verification behavior.
NODE_ENV=development
# Port used by scripts/dev.mjs and the Fastify API; defaults to 8787.
AUTONOMY_PORT=8787
# Fastify fallback port when AUTONOMY_PORT is unset.
PORT=8787
# Legacy config property; the server listener currently uses AUTONOMY_PORT/PORT instead.
BACKEND_PORT=3001
# Optional Vite API proxy override; defaults to VITE_BACKEND_URL or the AUTONOMY_PORT loopback URL.
AUTONOMY_PROXY_TARGET=http://127.0.0.1:8787

# Browser Supabase project URL.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
# Browser Supabase anon key; safe for browser use only when RLS policies are correct.
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Server-side Supabase project URL; falls back to VITE_SUPABASE_URL.
SUPABASE_URL=https://your-project-id.supabase.co
# Server-side Supabase anon key; falls back to VITE_SUPABASE_ANON_KEY.
SUPABASE_ANON_KEY=your-anon-key-here
# Server-only Massive market data key; never use a VITE_ prefix.
MASSIVE_API_KEY=your-massive-api-key-here
# Server-only Twelve Data key for instruments assigned to that provider.
TWELVEDATA_API_KEY=your-twelvedata-api-key-here
# Optional browser API base URL used by the Vite proxy.
VITE_BACKEND_URL=http://localhost:8787
# Optional Massive REST endpoint override for controlled deployments/tests.
MASSIVE_REST_URL=https://api.massive.com
# Optional Twelve Data REST endpoint override for controlled deployments/tests.
TWELVEDATA_REST_URL=https://api.twelvedata.com
# Optional server-side ML maintenance token fallback; prefer caller-scoped access tokens.
SERVICE_ACCESS_TOKEN=replace-with-a-maintenance-token-if-required
# Server-side URL reachable from Supabase Edge Functions; local Docker may use host.docker.internal.
BACKEND_URL=http://host.docker.internal:8787
# Supabase ML Edge Function mode; production requires an HTTPS BACKEND_URL.
ML_FUNCTION_ENV=development
# Server-only maintenance secret for restricted ML operations.
ML_SERVICE_API_KEY=replace-with-a-random-server-secret
# Server-only Gemini key for Kinetic Coach.
GEMINI_API_KEY=your-gemini-api-key-here
# Server-only Supabase service role key; grants privileged database access.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Allowed frontend origin(s), comma-separated; required by the API in production.
CORS_ORIGIN=http://localhost:5173

# Fastify rate-limit window in milliseconds.
RATE_LIMIT_WINDOW_MS=60000
# Authenticated market requests allowed per user per rate-limit window.
MARKET_RATE_LIMIT_MAX=60
# Authenticated analysis requests allowed per user per rate-limit window.
ANALYZE_RATE_LIMIT_MAX=5
# Maximum market-data series retained in the process-local cache.
MARKET_DATA_CACHE_MAX_ENTRIES=500
# Maximum stale fallback age as a multiple of the timeframe TTL.
MARKET_DATA_MAX_STALE_TTL_MULTIPLIER=3
# Delay between market availability probes in milliseconds.
MARKET_PROBE_INTERVAL_MS=1000
# Administrative market-universe probes allowed per user per rate-limit window.
MARKET_PROBE_RATE_LIMIT_MAX=1
# Optional verified Massive crypto symbols; each value must be an active registry symbol.
MARKETS_VERIFIED_OVERRIDE=
# Default active canonical market symbol.
DEFAULT_SYMBOL=BTCUSD
# Comma-separated active canonical scheduler symbols.
AUTONOMY_SYMBOLS=BTCUSD
# Start the automatic paper-trading scheduler only when set to true.
AUTONOMOUS_TRADING=false
# Impact floor for manual event blackouts; accepted values are low, medium, high.
EVENT_BLACKOUT_MIN_IMPACT=medium
# Server-side requirement for AAL2 on administrative API routes.
REQUIRE_ADMIN_MFA=false
# Public UI mirror used to explain a server-side admin MFA requirement before navigation.
VITE_REQUIRE_ADMIN_MFA=false
# JSON exchange session calendar; missing non-crypto calendars block entries.
MARKET_SESSION_CALENDAR_JSON={}
# Master switch for live price streaming; when false the app uses REST polling only.
LIVE_FEED_ENABLED=false
# Enables the Coinbase public WebSocket adapter for USD crypto when live feeds are on.
LIVE_FEED_COINBASE_ENABLED=true
# Enables the Twelve Data WebSocket adapter for the configured forex, commodity and stock symbols when live feeds are on.
LIVE_FEED_TWELVEDATA_ENABLED=true
# Comma-separated active forex, commodity or stock symbols streamed from Twelve Data; each must be streamable.
LIVE_FEED_TWELVEDATA_SYMBOLS=EURUSD,GBPUSD,USDJPY,XAUUSD
# Maximum symbols on the single Twelve Data connection; the provider trial limit recorded in docs/LIVEFEED.md.
LIVE_FEED_TWELVEDATA_MAX_SYMBOLS=8
# Maximum crypto symbols subscribed on the Coinbase connection.
LIVE_FEED_MAX_SYMBOLS=20
# Maximum browser clients connected to the live stream gateway at once.
LIVE_FEED_MAX_CLIENTS=100
# Milliseconds without a tick after which a symbol no longer displays as Live.
LIVE_FEED_STALE_MS=10000

# Starting simulated account equity in USD.
TRADER_STARTING_EQUITY=100000
# Equity-at-risk percentage used for stop-based paper position sizing.
RISK_PER_TRADE_PCT=0.5
# Maximum total open portfolio stop risk as a percentage of equity.
MAX_PORTFOLIO_HEAT_PCT=2
# Maximum gross notional exposure as a percentage of equity.
MAX_GROSS_EXPOSURE_PCT=50
# Maximum notional exposure per symbol as a percentage of equity.
MAX_SYMBOL_EXPOSURE_PCT=25
# Maximum simultaneous paper positions.
MAX_CONCURRENT_POSITIONS=3
# Maximum simultaneous positions in one configured correlation cluster.
MAX_CORRELATED_POSITIONS=1
# Daily realized-loss stop as a percentage of equity.
DAILY_LOSS_STOP_PCT=2
# Weekly realized-loss stop as a percentage of equity.
WEEKLY_LOSS_STOP_PCT=5
# Maximum peak-to-trough equity drawdown percentage.
MAX_DRAWDOWN_PCT=20
# Consecutive-loss limit before paper trading cooldown.
LOSS_STREAK_LIMIT=3
# Cooldown length in bars after the configured loss streak.
LOSS_STREAK_COOLDOWN_BARS=24
# Minimum reward-to-risk ratio for a paper entry.
MIN_RR=2
# Simulated paper execution fee rate.
FEE_RATE=0.001
# Simulated paper execution slippage rate.
SLIPPAGE_RATE=0.0005
# Comma-separated higher-timeframe planner inputs.
HTF_TIMEFRAMES=4h,1d
# Comma-separated trigger timeframe inputs.
TRIGGER_TIMEFRAMES=15m,1h
# Position-management timeframe.
MGMT_TIMEFRAME=5m
# Maximum pending-plan lifetime in bars.
PLAN_EXPIRY_BARS=24
# Grace period after candle close before scheduled processing.
CLOSE_GRACE_MS=7000
# Maximum candle age allowed for a new entry.
MAX_ENTRY_AGE_BARS=2
# Maximum ordered candles processed during scheduler catch-up.
SCHEDULER_MAX_CATCH_UP_BARS=100
# Delay between symbol jobs in milliseconds.
SCHEDULER_SYMBOL_DELAY_MS=250
# Random scheduler delay ceiling in milliseconds.
SCHEDULER_JITTER_MS=1000
# Provider/scheduler failures tolerated before pausing automation.
MAX_CONSECUTIVE_PROVIDER_FAILURES=3
# Minimum completed trades before statistics are presented.
MIN_TRADES_FOR_STATS=30
# Bootstrap iterations for research confidence intervals.
BOOTSTRAP_ITERATIONS=1000
# Confidence level for bootstrap intervals; must be between 0.5 and 1.
BOOTSTRAP_CONFIDENCE_LEVEL=0.95
# Number of probability calibration reliability bins.
CALIBRATION_RELIABILITY_BINS=10
# Seed for reproducible research calculations.
RESEARCH_RANDOM_SEED=42
# Minimum forward trades required for setup promotion.
MIN_FORWARD_TRADES=100
# Minimum forward-test duration in days for setup promotion.
MIN_FORWARD_DAYS=90
# Minimum seeded random-baseline runs for promotion.
MIN_RANDOM_BASELINE_RUNS=1000
# Keep triggered setups in shadow-only mode unless explicitly disabled.
SHADOW_MODE_ENABLED=true
# Comma-separated setup types that passed the forward-evidence promotion gate.
PROMOTED_SETUP_TYPES=
# Favorable-R threshold for moving a stop to break-even.
BREAK_EVEN_R=1
# Favorable-R threshold for starting a trailing stop.
TRAIL_START_R=2
# ATR multiple used by the trailing stop.
TRAILING_ATR_MULTIPLE=2
# Maximum bars held before time-stop evaluation.
TIME_STOP_BARS=96
# Minimum progress in R required to avoid the time stop.
TIME_STOP_MIN_PROGRESS_R=0.25
# Comma-separated allowed plan grades.
ALLOWED_GRADES=A,B
# Comma-separated allowed planner setup types.
ALLOWED_SETUP_TYPES=trend-pullback
# Maximum configured planner watchlist size.
WATCHLIST_MAX_SIZE=12
# Block entries whenever any required market data series is stale.
STALE_DATA_BLOCKS_ENTRIES=true
