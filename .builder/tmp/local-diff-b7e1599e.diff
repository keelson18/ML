[L:775] +## 6. The Autonomous Paper Trading Engine
[L:776] +
[L:777] +### 6.1 Order Execution (Automatic)
[L:778] +
[L:779] +```typescript
[L:780] +// apps/api/src/paper/autoExecution.ts
[L:781] +
[L:782] +class AutonomousPaperTradingEngine {
[L:783] +  async onDecision(decision: TradeDecision): Promise<void> {
[L:784] +    if (decision.decisionType !== 'BUY' && decision.decisionType !== 'SELL') {
[L:785] +      return; // NO_TRADE, WATCH — nothing to execute
[L:786] +    }
[L:787] +
[L:788] +    // 1. Create order
[L:789] +    const order = await this.createOrder(decision);
[L:790] +
[L:791] +    // 2. Wait for next candle to simulate fill
[L:792] +    const fillCandle = await this.waitForNextCandle(decision.symbol, decision.timeframe);
[L:793] +
[L:794] +    // 3. Simulate fill price
[L:795] +    const fillPrice = this.calculateFillPrice(order, fillCandle);
[L:796] +
[L:797] +    // 4. Apply slippage
[L:798] +    const slippage = this.calculateSlippage(decision.symbol, fillCandle);
[L:799] +    const finalFillPrice = order.side === 'long' 
[L:800] +      ? fillPrice + slippage 
[L:801] +      : fillPrice - slippage;
[L:802] +
[L:803] +    // 5. Apply commission
[L:804] +    const commission = finalFillPrice * order.quantity * 0.001;
[L:805] +
[L:806] +    // 6. Create fill record
[L:807] +    const fill = await this.createFill(order, finalFillPrice, slippage, commission);
[L:808] +
[L:809] +    // 7. Open position
[L:810] +    const position = await this.openPosition(fill);
[L:811] +
[L:812] +    // 8. Start position monitoring
[L:813] +    this.startPositionMonitor(position);
[L:814] +
[L:815] +    // 9. Broadcast to user
[L:816] +    await this.broadcastTradeExecuted(decision, position);
[L:817] +
[L:818] +    // 10. Log
[L:819] +    await this.logTrade(decision, position);
[L:820] +  }
[L:821] +
[L:822] +  private async startPositionMonitor(position: PaperPosition): Promise<void> {
[L:823] +    // Subscribe to new candles for this symbol
[L:824] +    const unsubscribe = candleStream.subscribe(position.symbol, position.timeframe, async (candle) => {
[L:825] +      // Check stop loss
[L:826] +      if (this.isStopLossHit(position, candle)) {
[L:827] +        await this.closePosition(position, candle, 'stop_loss');
[L:828] +        unsubscribe();
[L:829] +        return;
[L:830] +      }
[L:831] +
[L:832] +      // Check take profits
[L:833] +      for (const target of position.takeProfits) {
[L:834] +        if (this.isTargetHit(position, target, candle)) {
[L:835] +          await this.partialClose(position, candle, target);
[L:836] +          if (position.remainingQuantity <= 0) {
[L:837] +            unsubscribe();
[L:838] +            return;
[L:839] +          }
[L:840] +        }
[L:841] +      }
[L:842] +
[L:843] +      // Update trailing stop
[L:844] +      if (position.trailingStop) {
[L:845] +        await this.updateTrailingStop(position, candle);
[L:846] +      }
[L:847] +
[L:848] +      // Update unrealized P&L
[L:849] +      await this.updateUnrealizedPnl(position, candle);
[L:850] +
[L:851] +      // Broadcast P&L update
[L:852] +      await this.broadcastPositionUpdate(position);
[L:853] +    });
[L:854] +  }
[L:855] +
[L:856] +  private async closePosition(position: PaperPosition, candle: Candle, reason: string): Promise<void> {
[L:857] +    // Calculate realized P&L
[L:858] +    const realizedPnl = this.calculateRealizedPnl(position, candle.close);
[L:859] +
[L:860] +    // Apply slippage and commission on exit
[L:861] +    const exitSlippage = this.calculateSlippage(position.symbol, candle);
[L:862] +    const exitCommission = candle.close * position.remainingQuantity * 0.001;
[L:863] +
[L:864] +    // Update position
[L:865] +    position.status = 'closed';
[L:866] +    position.closePrice = candle.close;
[L:867] +    position.closeTimestamp = candle.timestamp;
[L:868] +    position.closeReason = reason;
[L:869] +    position.realizedPnl = realizedPnl - exitSlippage - exitCommission;
[L:870] +
[L:871] +    // Persist
[L:872] +    await this.persistPosition(position);
[L:873] +
[L:874] +    // Generate trade review
[L:875] +    const review = await tradeReviewEngine.generate(position);
[L:876] +    await this.persistReview(review);
[L:877] +
[L:878] +    // Update knowledge
[L:879] +    await knowledgeEngine.learnFromTrade(position, review);
[L:880] +
[L:881] +    // Broadcast
[L:882] +    await this.broadcastPositionClosed(position);
[L:883] +    await this.sendAlert('position_closed', { position, review });
[L:884] +
[L:885] +    // Check circuit breakers
[L:886] +    await this.checkPostTradeCircuitBreakers(position);
[L:887] +  }
[L:888] +}
[L:889] +```
