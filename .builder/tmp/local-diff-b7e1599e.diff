[L:188] +---
[L:189] +
[L:190] +## 5. Event-Driven Architecture (The Core)
[L:191] +
[L:192] +Quantum is built around an event bus. This is the single most important architectural decision.
[L:193] +
[L:194] +### Why Events?
[L:195] +- **Backtesting = Real-time**: The same pipeline that runs live also runs historically. Just replay events from Kafka.
[L:196] +- **Decoupling**: The ingest service doesn't know about the decision engine. The decision engine doesn't know about paper trading.
[L:197] +- **Observability**: Every step is logged as an event. Audit trails are free.
[L:198] +- **Scaling**: Add more consumers without changing producers.
[L:199] +
[L:200] +### Event Types
[L:201] +
[L:202] +```typescript
[L:203] +// packages/shared/src/types/events.ts
[L:204] +
[L:205] +interface MarketEvent {
[L:206] +  type: 'candle.closed';
[L:207] +  payload: {
[L:208] +    symbol: string;
[L:209] +    timeframe: Timeframe;
[L:210] +    candle: Candle;
[L:211] +    timestamp: number;
[L:212] +  };
[L:213] +  metadata: {
[L:214] +    source: 'eodhd' | 'binance';
[L:215] +    ingestionLatencyMs: number;
[L:216] +  };
[L:217] +}
[L:218] +
[L:219] +interface AnalysisEvent {
[L:220] +  type: 'evidence.generated';
[L:221] +  payload: {
[L:222] +    symbol: string;
[L:223] +    timeframe: Timeframe;
[L:224] +    evidence: Evidence[];
[L:225] +    engine: string;
[L:226] +    engineVersion: string;
[L:227] +  };
[L:228] +}
[L:229] +
[L:230] +interface DecisionEvent {
