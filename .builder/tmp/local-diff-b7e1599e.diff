[L:176] +   ┌────────┐  ┌────────┐  ┌────────┐
[L:177] +   │VETOED  │  │WATCH   │  │EXECUTE │
[L:178] +   │NO_TRADE│  │(wait)  │  │(order) │
[L:179] +   └────┬───┘  └────┬───┘  └────┬───┘
[L:180] +        │           │           │
[L:181] +        ▼           ▼           ▼
[L:182] +   ┌────────┐  ┌────────┐  ┌────────┐
[L:183] +   │  IDLE  │  │MONITOR-│  │POSITION │
[L:184] +   │        │  │  ING   │  │  OPEN   │
[L:185] +   └────────┘  └────────┘  └────┬───┘
[L:186] +                                │ SL/TP hit
[L:187] +                                ▼
[L:188] +                           ┌────────┐
[L:189] +                           │ CLOSED │
[L:190] +                           └────┬───┘
[L:191] +                                │ Review generated
[L:192] +                                ▼
[L:193] +                           ┌────────┐
[L:194] +                           │  IDLE  │
[L:195] +                           └────────┘
[L:196] +```
[L:197] +
[L:198] +**State Transitions are Automatic.** No human clicks a button to move from MONITORING to DECIDING. The scheduler triggers the pipeline every N seconds or every new candle.
[L:199] +
[L:200] +---
[L:201] +
[L:202] +## 3. The Autonomous Execution Flow
[L:203] +
[L:204] +### 3.1 Trigger Mechanisms
[L:205] +
[L:206] +The decision pipeline triggers automatically on:
[L:207] +
[L:208] +1. **Candle Close** — Primary trigger. Every time a candle closes on the execution timeframe, the pipeline runs.
[L:209] +2. **Scheduled Interval** — Fallback. Every 60 seconds if no new candle (for low-liquidity periods).
[L:210] +3. **Liquidity Event** — Reactive. If a liquidity sweep is detected mid-candle, the pipeline runs immediately.
[L:211] +4. **Structure Event** — Reactive. If BOS or MSS is detected mid-candle, the pipeline runs immediately.
[L:212] +5. **Manual Trigger** — For testing/backtesting only. Admin can trigger a manual run.
[L:213] +
[L:214] +### 3.2 The Full Autonomous Pipeline
[L:215] +
[L:216] +```typescript
[L:217] +// apps/scheduler/src/pipeline.ts
[L:218] +
[L:219] +class AutonomousPipeline {
[L:220] +  private state: SystemState = 'IDLE';
[L:221] +  private activeSymbols: string[] = [];
[L:222] +  private config: AutonomousConfig;
[L:223] +
[L:224] +  async start(): Promise<void> {
[L:225] +    // 1. Load configuration
[L:226] +    this.config = await this.loadConfig();
[L:227] +    this.activeSymbols = this.config.symbols;
[L:228] +
[L:229] +    // 2. Start cron jobs
[L:230] +    this.scheduleCandleCloseTriggers();
[L:231] +    this.scheduleHealthChecks();
[L:232] +    this.schedulePortfolioSnapshots();
[L:233] +
[L:234] +    // 3. Start reactive listeners
[L:235] +    this.subscribeToLiquidityEvents();
[L:236] +    this.subscribeToStructureEvents();
[L:237] +
[L:238] +    // 4. Set state
[L:239] +    this.state = 'MONITORING';
[L:240] +    await this.broadcastState();
[L:241] +  }
[L:242] +
[L:243] +  async onCandleClose(symbol: string, timeframe: string, candle: Candle): Promise<void> {
[L:244] +    if (this.state !== 'MONITORING') return;
[L:245] +
[L:246] +    // Check if symbol is in active watchlist
[L:247] +    if (!this.activeSymbols.includes(symbol)) return;
[L:248] +
[L:249] +    // Check kill zone
[L:250] +    if (!this.isInKillZone()) {
[L:251] +      this.logSkip(symbol, 'Outside kill zone');
[L:252] +      return;
[L:253] +    }
[L:254] +
[L:255] +    // Check circuit breakers
[L:256] +    const circuitBreaker = await this.checkCircuitBreakers();
[L:257] +    if (circuitBreaker.triggered) {
[L:258] +      await this.triggerCircuitBreaker(circuitBreaker);
[L:259] +      return;
[L:260] +    }
[L:261] +
[L:262] +    // Run the full pipeline
[L:263] +    await this.runDecisionPipeline(symbol, timeframe, candle);
[L:264] +  }
[L:265] +
[L:266] +  private async runDecisionPipeline(symbol: string, timeframe: string, candle: Candle): Promise<void> {
[L:267] +    this.state = 'DECIDING';
[L:268] +    await this.broadcastState();
[L:269] +
[L:270] +    try {
[L:271] +      // 1. Data Quality
[L:272] +      const quality = await dataQualityEngine.check(symbol, timeframe, candle);
[L:273] +      if (!quality.passed) {
[L:274] +        await this.logDecision(symbol, 'NO_TRADE', 0, 'Data quality failed');
[L:275] +        return;
[L:276] +      }
[L:277] +
[L:278] +      // 2. Market Context
[L:279] +      const context = await marketContextEngine.build(symbol, timeframe, candle);
[L:280] +
[L:281] +      // 3. Gather Evidence (parallel)
[L:282] +      const evidence = await Promise.all([
[L:283] +        structureEngine.analyze({ symbol, timeframe, candle, context }),
[L:284] +        liquidityEngine.analyze({ symbol, timeframe, candle, context }),
[L:285] +        patternEngine.analyze({ symbol, timeframe, candle, context }),
[L:286] +        indicatorEngine.analyze({ symbol, timeframe, candle, context }),
[L:287] +        regimeEngine.analyze({ symbol, timeframe, candle, context }),
[L:288] +        strategyEngine.analyze({ symbol, timeframe, candle, context }),
[L:289] +        historicalSimilarityEngine.analyze({ symbol, timeframe, candle, context }),
[L:290] +        mlEngine.analyze({ symbol, timeframe, candle, context })
[L:291] +      ]);
[L:292] +
[L:293] +      // 4. Master Decision
[L:294] +      const decision = await masterDecisionEngine.decide({
[L:295] +        symbol, timeframe, candle, context, evidence
[L:296] +      });
[L:297] +
[L:298] +      // 5. Risk Gate (automatic veto)
[L:299] +      const riskCheck = await riskEngine.validate(decision);
[L:300] +      if (riskCheck.veto) {
[L:301] +        decision.decisionType = 'NO_TRADE';
[L:302] +        decision.reason = `Risk veto: ${riskCheck.reason}`;
[L:303] +        await this.persistDecision(decision);
[L:304] +        await this.sendAlert('risk_veto', decision);
[L:305] +        return;
[L:306] +      }
[L:307] +
[L:308] +      // 6. Portfolio Gate (automatic veto)
[L:309] +      const portfolioCheck = await portfolioEngine.validate(decision);
[L:310] +      if (portfolioCheck.veto) {
[L:311] +        decision.decisionType = 'NO_TRADE';
[L:312] +        decision.reason = `Portfolio veto: ${portfolioCheck.reason}`;
[L:313] +        await this.persistDecision(decision);
[L:314] +        await this.sendAlert('portfolio_veto', decision);
[L:315] +        return;
[L:316] +      }
[L:317] +
[L:318] +      // 7. Execute if BUY/SELL
[L:319] +      if (decision.decisionType === 'BUY' || decision.decisionType === 'SELL') {
[L:320] +        await this.executePaperTrade(decision);
[L:321] +      } else {
[L:322] +        await this.persistDecision(decision);
[L:323] +        this.logDecision(symbol, decision.decisionType, decision.confidence, decision.explanation);
[L:324] +      }
[L:325] +
[L:326] +    } catch (error) {
[L:327] +      await this.handlePipelineError(symbol, error);
[L:328] +    } finally {
[L:329] +      this.state = 'MONITORING';
[L:330] +      await this.broadcastState();
[L:331] +    }
[L:332] +  }
[L:333] +
[L:334] +  private async executePaperTrade(decision: TradeDecision): Promise<void> {
[L:335] +    // Create order
[L:336] +    const order = await paperTradingEngine.createOrder(decision);
[L:337] +
[L:338] +    // Simulate fill
[L:339] +    const fill = await paperTradingEngine.simulateFill(order);
[L:340] +
[L:341] +    // Open position
[L:342] +    const position = await paperTradingEngine.openPosition(fill);
[L:343] +
[L:344] +    // Persist
[L:345] +    await this.persistDecision(decision);
[L:346] +    await this.persistPosition(position);
[L:347] +
[L:348] +    // Broadcast to user
[L:349] +    await this.broadcastDecision(decision);
[L:350] +    await this.broadcastPosition(position);
[L:351] +    await this.sendAlert('trade_executed', { decision, position });
[L:352] +
[L:353] +    // Log
[L:354] +    this.logDecision(
[L:355] +      decision.symbol, 
[L:356] +      decision.decisionType, 
[L:357] +      decision.confidence, 
[L:358] +      `Auto-executed: ${decision.side} ${decision.symbol} at ${fill.price}`
[L:359] +    );
[L:360] +  }
[L:361] +}
[L:362] +```
[L:363] +
[L:364] +### 3.3 Position Lifecycle (Automatic)
[L:365] +
[L:366] +```
[L:367] +Position Opened
[L:368] +    ↓
[L:369] +Every new candle:
[L:370] +    ├── Check Stop Loss
[L:371] +    │   └── If hit → Close position, realize loss, generate review
[L:372] +    ├── Check Take Profit 1
[L:373] +    │   └── If hit → Partial close (e.g., 50%), move SL to breakeven
[L:374] +    ├── Check Take Profit 2
[L:375] +    │   └── If hit → Partial close (e.g., 30%), trail remaining
[L:376] +    ├── Check Take Profit 3
[L:377] +    │   └── If hit → Close remainder
[L:378] +    ├── Update Trailing Stop (if activated)
[L:379] +    │   └── If price moves favorably, move SL to lock profit
[L:380] +    └── Update Unrealized P&L
[L:381] +        └── Broadcast to dashboard
[L:382] +```
[L:383] +
[L:384] +**All of this happens automatically. The user sees it on the dashboard in real-time.**
