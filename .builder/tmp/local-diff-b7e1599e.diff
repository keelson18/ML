[L:1] +import { fetchKlines } from '../../../src/lib/binance';
[L:2] +import type { Candle, Timeframe } from '../../../src/lib/types';
[L:3] +import { analyze } from '../services/decisionService';
[L:4] +import { executeDecision, getAccount, manageOpenPositions } from '../services/paperTradingService';
[L:5] +import type { AutonomousConfig, AutonomousState, PipelineResult, PipelineSnapshot } from './types';
[L:6] +
[L:7] +const DEFAULT_CONFIG: AutonomousConfig = {
[L:8] +  symbols: ['BTCUSDT', 'ETHUSDT'],
[L:9] +  timeframe: '15m',
[L:10] +  accountId: 'default',
[L:11] +  enableExecution: true,
[L:12] +  killZonesUtc: [{ startHour: 8, endHour: 10 }, { startHour: 14, endHour: 17 }],
[L:13] +  maxConsecutiveFailures: 3,
[L:14] +};
[L:15] +
[L:16] +export class AutonomousPipeline {
[L:17] +  private readonly config: AutonomousConfig;
[L:18] +  private state: AutonomousState = 'OFFLINE';
[L:19] +  private failures = 0;
[L:20] +  private readonly processedCandles = new Map<string, number>();
[L:21] +  private snapshot: PipelineSnapshot = { state: 'OFFLINE', processedDecisions: 0, executedOrders: 0, skippedRuns: 0, consecutiveFailures: 0 };
[L:22] +
[L:23] +  constructor(config: Partial<AutonomousConfig> = {}) {
[L:24] +    this.config = { ...DEFAULT_CONFIG, ...config, symbols: config.symbols ?? DEFAULT_CONFIG.symbols };
[L:25] +  }
[L:26] +
[L:27] +  getSnapshot(): PipelineSnapshot {
[L:28] +    return { ...this.snapshot, state: this.state };
[L:29] +  }
[L:30] +
[L:31] +  getAccount() {
[L:32] +    return getAccount(this.config.accountId);
[L:33] +  }
[L:34] +
[L:35] +  start() {
[L:36] +    if (this.state === 'PAUSED') return;
[L:37] +    this.transition('MONITORING');
[L:38] +  }
[L:39] +
[L:40] +  pause() {
[L:41] +    this.transition('PAUSED');
[L:42] +  }
[L:43] +
[L:44] +  stop() {
[L:45] +    this.transition('OFFLINE');
[L:46] +  }
[L:47] +
[L:48] +  async runOnce(symbol: string, timeframe: Timeframe = this.config.timeframe, candles?: Candle[]): Promise<PipelineResult> {
[L:49] +    const series = candles ?? await fetchKlines(symbol, timeframe, 501);
[L:50] +    const closedCandle = series[series.length - 2];
[L:51] +    if (!closedCandle) throw new Error(`No closed candle available for ${symbol}.`);
[L:52] +    if (this.state === 'PAUSED' || this.state === 'OFFLINE') return { symbol, timeframe, candle: closedCandle, skipped: `Pipeline is ${this.state}.`, state: this.state };
[L:53] +    const closedTrades = await manageOpenPositions(this.config.accountId, symbol, closedCandle);
[L:54] +    if (this.processedCandles.get(symbol) === closedCandle.time) return { symbol, timeframe, candle: closedCandle, skipped: 'Closed candle already processed.', closedTrades, state: this.state };
[L:55] +    if (!this.inKillZone()) return { ...this.skip(symbol, timeframe, closedCandle, 'Outside configured kill zone.'), closedTrades };
[L:56] +
[L:57] +    this.transition('DECIDING');
[L:58] +    try {
[L:59] +      const result = await analyze({ symbol, timeframe, candles: series.slice(0, -1) });
[L:60] +      const decision = result.decision.result;
[L:61] +      this.processedCandles.set(symbol, closedCandle.time);
[L:62] +      this.snapshot = { ...this.snapshot, state: 'MONITORING', lastRunAt: new Date().toISOString(), lastClosedCandle: { symbol, time: closedCandle.time }, processedDecisions: this.snapshot.processedDecisions + 1, consecutiveFailures: 0 };
[L:63] +      this.failures = 0;
[L:64] +
[L:65] +      if (this.config.enableExecution && (decision.decision === 'BUY' || decision.decision === 'SELL')) {
[L:66] +        const order = await executeDecision({ accountId: this.config.accountId, symbol, decision });
[L:67] +        this.snapshot = { ...this.snapshot, executedOrders: this.snapshot.executedOrders + (order.accepted ? 1 : 0) };
[L:68] +        return { symbol, timeframe, candle: closedCandle, decision, order, closedTrades, state: this.state };
[L:69] +      }
[L:70] +      return { symbol, timeframe, candle: closedCandle, decision, closedTrades, state: this.state };
[L:71] +    } catch (error) {
[L:72] +      this.failures += 1;
[L:73] +      const errorMessage = error instanceof Error ? error.message : 'Unknown pipeline failure.';
[L:74] +      this.state = this.failures >= this.config.maxConsecutiveFailures ? 'PAUSED' : 'ERROR';
[L:75] +      this.snapshot = { ...this.snapshot, state: this.state, consecutiveFailures: this.failures, lastError: errorMessage };
[L:76] +      throw error;
[L:77] +    } finally {
[L:78] +      if (this.state === 'DECIDING') this.transition('MONITORING');
[L:79] +    }
[L:80] +  }
[L:81] +
[L:82] +  private skip(symbol: string, timeframe: Timeframe, candle: Candle, reason: string): PipelineResult {
[L:83] +    this.snapshot = { ...this.snapshot, skippedRuns: this.snapshot.skippedRuns + 1, lastRunAt: new Date().toISOString() };
[L:84] +    return { symbol, timeframe, candle, skipped: reason, state: this.state };
[L:85] +  }
[L:86] +
[L:87] +  private inKillZone() {
[L:88] +    const hour = new Date().getUTCHours();
[L:89] +    return this.config.killZonesUtc.some((zone) => hour >= zone.startHour && hour < zone.endHour);
[L:90] +  }
[L:91] +
[L:92] +  private transition(state: AutonomousState) {
[L:93] +    this.state = state;
[L:94] +    this.snapshot = { ...this.snapshot, state };
[L:95] +  }
[L:96] +}
