[L:1136] +## 15. Real-Time Architecture
[L:1137] +
[L:1138] +### WebSocket Server (`apps/ws`)
[L:1139] +
[L:1140] +```typescript
[L:1141] +// WebSocket server maintains connections and broadcasts
[L:1142] +class MarketWebSocketServer {
[L:1143] +  private clients = new Map<string, WebSocket>();
[L:1144] +  private subscriptions = new Map<string, Set<string>>(); // symbol -> clientIds
[L:1145] +
[L:1146] +  async start(): Promise<void> {
[L:1147] +    // Subscribe to Kafka topic 'candle.closed'
[L:1148] +    kafkaConsumer.subscribe('candle.closed', (event) => {
[L:1149] +      this.broadcast(event.payload.symbol, event.payload.candle);
[L:1150] +    });
[L:1151] +
[L:1152] +    // Subscribe to Kafka topic 'decision.generated'
[L:1153] +    kafkaConsumer.subscribe('decision.generated', (event) => {
[L:1154] +      this.broadcastDecision(event.payload.decision);
[L:1155] +    });
[L:1156] +  }
[L:1157] +
[L:1158] +  private broadcast(symbol: string, candle: Candle): void {
[L:1159] +    const clients = this.subscriptions.get(symbol);
[L:1160] +    if (!clients) return;
[L:1161] +
[L:1162] +    const message = JSON.stringify({ type: 'candle', symbol, candle });
[L:1163] +    for (const clientId of clients) {
[L:1164] +      const ws = this.clients.get(clientId);
[L:1165] +      if (ws?.readyState === WebSocket.OPEN) {
[L:1166] +        ws.send(message);
[L:1167] +      }
[L:1168] +    }
[L:1169] +  }
[L:1170] +}
[L:1171] +```
[L:1172] +
[L:1173] +### Frontend Connection
[L:1174] +
[L:1175] +```typescript
[L:1176] +// hooks/useMarketStream.ts
[L:1177] +export function useMarketStream(symbol: string, timeframe: Timeframe) {
[L:1178] +  const queryClient = useQueryClient();
[L:1179] +
[L:1180] +  useEffect(() => {
[L:1181] +    const ws = new WebSocket(WS_URL);
[L:1182] +
[L:1183] +    ws.onmessage = (event) => {
[L:1184] +      const data = JSON.parse(event.data);
[L:1185] +      if (data.type === 'candle' && data.symbol === symbol) {
[L:1186] +        // Update React Query cache
[L:1187] +        queryClient.setQueryData(
[L:1188] +          ['market', 'candles', symbol, timeframe],
[L:1189] +          (old: Candle[]) => [...old.slice(-999), data.candle]
[L:1190] +        );
[L:1191] +      }
[L:1192] +    };
[L:1193] +
[L:1194] +    return () => ws.close();
[L:1195] +  }, [symbol, timeframe, queryClient]);
[L:1196] +}
[L:1197] +```
