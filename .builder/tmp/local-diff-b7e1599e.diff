[L:293] +
[L:294] +## 6. The Engine Plugin Architecture
[L:295] +
[L:296] +Every analytical engine is a plugin. This is how you scale from 3 engines to 20 without chaos.
[L:297] +
[L:298] +### Engine Interface
[L:299] +
[L:300] +```typescript
[L:301] +// packages/shared/src/types/engine.ts
[L:302] +
[L:303] +interface IAnalysisEngine {
[L:304] +  readonly name: string;
[L:305] +  readonly version: string;
[L:306] +  readonly supportedTimeframes: Timeframe[];
[L:307] +  readonly requiredCandles: number;        // Lookback required
[L:308] +  readonly outputType: 'evidence' | 'regime' | 'signal';
[L:309] +
[L:310] +  // Core method: given candles up to index i, return evidence
[L:311] +  analyze(params: {
[L:312] +    symbol: string;
[L:313] +    timeframe: Timeframe;
[L:314] +    candles: Candle[];                    // [0..i], never [0..end]
[L:315] +    context: MarketContext;               // Current regime, structure, etc.
[L:316] +  }): Promise<Evidence[]>;
[L:317] +
[L:318] +  // Explain a specific piece of evidence
[L:319] +  explain(evidence: Evidence): string;
[L:320] +
[L:321] +  // Validate configuration
[L:322] +  validateConfig(config: unknown): boolean;
[L:323] +}
[L:324] +```
[L:325] +
[L:326] +### Engine Registry
[L:327] +
[L:328] +```typescript
[L:329] +// apps/api/src/engines/registry.ts
[L:330] +
[L:331] +class EngineRegistry {
[L:332] +  private engines = new Map<string, IAnalysisEngine>();
[L:333] +
[L:334] +  register(engine: IAnalysisEngine): void {
[L:335] +    this.engines.set(engine.name, engine);
[L:336] +  }
[L:337] +
[L:338] +  async runAll(params: AnalyzeParams): Promise<Evidence[]> {
[L:339] +    const results = await Promise.all(
[L:340] +      Array.from(this.engines.values()).map(engine => 
[L:341] +        engine.analyze(params).catch(err => {
[L:342] +          logger.error(`Engine ${engine.name} failed`, err);
[L:343] +          return [];
[L:344] +        })
[L:345] +      )
[L:346] +    );
[L:347] +    return results.flat();
[L:348] +  }
[L:349] +}
[L:350] +```
[L:351] +
[L:352] +### Built-in Engines (MVP)
[L:353] +
[L:354] +| Engine | Type | Weight (default) | Description |
[L:355] +|--------|------|------------------|-------------|
[L:356] +| `indicator` | Evidence | 0.20 | RSI, MACD, EMA crossovers, Bollinger |
[L:357] +| `structure` | Evidence | 0.25 | Swing highs/lows, BOS/CHoCH, trend |
[L:358] +| `regime` | Context | — | Classifies market as trending/ranging/volatile |
[L:359] +| `ml-lightgbm` | Evidence | 0.30 | Gradient boosting prediction |
[L:360] +| `risk` | Gate | — | Veto power. Can reject any decision. |
[L:361] +| `portfolio` | Constraint | — | Adjusts size based on current exposure. |
[L:362] +
[L:363] +**Deferred engines** (post-MVP): liquidity, patterns, historical similarity, institutional, news sentiment.
