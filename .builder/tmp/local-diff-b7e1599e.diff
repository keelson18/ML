[L:766] +### 5.3 Database Schema for RBAC
[L:767] +
[L:768] +```sql
[L:769] +-- Supabase Auth handles auth.users
[L:770] +-- We extend with profiles and roles
[L:771] +
[L:772] +CREATE TABLE profiles (
[L:773] +  id UUID PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,
[L:774] +  email TEXT NOT NULL,
[L:775] +  first_name TEXT,
[L:776] +  last_name TEXT,
[L:777] +  display_name TEXT,
[L:778] +  avatar_url TEXT,
[L:779] +  timezone TEXT DEFAULT 'UTC',
[L:780] +  base_currency TEXT DEFAULT 'USD',
[L:781] +  risk_profile_id UUID,
[L:782] +  is_active BOOLEAN DEFAULT TRUE,
[L:783] +  created_at TIMESTAMPTZ DEFAULT NOW(),
[L:784] +  updated_at TIMESTAMPTZ DEFAULT NOW()
[L:785] +);
[L:786] +
[L:787] +-- Role assignments (many-to-many: user can have multiple roles)
[L:788] +CREATE TABLE user_roles (
[L:789] +  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
[L:790] +  user_id UUID NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,
[L:791] +  role TEXT NOT NULL CHECK (role IN ('user', 'admin', 'super_admin')),
[L:792] +  assigned_by UUID REFERENCES auth.users(id),
[L:793] +  assigned_at TIMESTAMPTZ DEFAULT NOW(),
[L:794] +  UNIQUE(user_id, role)
[L:795] +);
[L:796] +
[L:797] +-- Role change audit
[L:798] +CREATE TABLE role_changes (
[L:799] +  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
[L:800] +  user_id UUID NOT NULL REFERENCES auth.users(id),
[L:801] +  old_role TEXT,
[L:802] +  new_role TEXT NOT NULL,
[L:803] +  changed_by UUID NOT NULL REFERENCES auth.users(id),
[L:804] +  reason TEXT,
[L:805] +  created_at TIMESTAMPTZ DEFAULT NOW()
[L:806] +);
[L:807] +
[L:808] +-- Admin settings (system-wide config)
[L:809] +CREATE TABLE system_settings (
[L:810] +  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
[L:811] +  key TEXT NOT NULL UNIQUE,
[L:812] +  value JSONB NOT NULL,
[L:813] +  description TEXT,
[L:814] +  updated_by UUID REFERENCES auth.users(id),
[L:815] +  updated_at TIMESTAMPTZ DEFAULT NOW()
[L:816] +);
[L:817] +
[L:818] +-- RLS Policies
[L:819] +ALTER TABLE profiles ENABLE ROW LEVEL SECURITY;
[L:820] +
[L:821] +-- Users can only see/edit their own profile
[L:822] +CREATE POLICY "Users can access own profile"
[L:823] +  ON profiles FOR ALL USING (auth.uid() = id);
[L:824] +
[L:825] +-- Admins can view all profiles (read-only via API layer, not direct DB)
[L:826] +-- Super admins bypass RLS via service_role
[L:827] +
[L:828] +ALTER TABLE user_roles ENABLE ROW LEVEL SECURITY;
[L:829] +
[L:830] +-- Users can see their own roles
[L:831] +CREATE POLICY "Users can view own roles"
[L:832] +  ON user_roles FOR SELECT USING (auth.uid() = user_id);
[L:833] +
[L:834] +-- Super admin role cannot be deleted via API (enforced in application layer)
[L:835] +```
[L:836] +
[L:837] +### 5.4 API Authorization Guards
[L:838] +
[L:839] +```typescript
[L:840] +// apps/api/src/plugins/rbac.ts
[L:841] +
[L:842] +import { FastifyInstance, FastifyRequest, FastifyReply } from 'fastify';
[L:843] +
[L:844] +declare module 'fastify' {
[L:845] +  interface FastifyRequest {
[L:846] +    user: {
[L:847] +      id: string;
[L:848] +      email: string;
[L:849] +      roles: string[];
[L:850] +    };
[L:851] +  }
[L:852] +}
[L:853] +
[L:854] +export async function rbacPlugin(fastify: FastifyInstance) {
[L:855] +  fastify.decorate('requireRole', (roles: string[]) => {
[L:856] +    return async (request: FastifyRequest, reply: FastifyReply) => {
[L:857] +      if (!request.user) {
[L:858] +        return reply.status(401).send({ error: 'Unauthorized' });
[L:859] +      }
[L:860] +      const hasRole = roles.some(role => request.user.roles.includes(role));
[L:861] +      if (!hasRole) {
[L:862] +        return reply.status(403).send({ error: 'Forbidden: insufficient privileges' });
[L:863] +      }
[L:864] +    };
[L:865] +  });
[L:866] +}
[L:867] +
[L:868] +// Usage in routes:
[L:869] +// fastify.get('/admin/users', { preHandler: [fastify.requireRole(['admin', 'super_admin'])] }, handler);
[L:870] +// fastify.post('/admin/secrets/rotate', { preHandler: [fastify.requireRole(['super_admin'])] }, handler);
[L:871] +```
[L:872] +
[L:873] +### 5.5 Frontend Route Guards
[L:874] +
[L:875] +```typescript
[L:876] +// apps/web/src/hooks/useRole.ts
[L:877] +
[L:878] +import { useAuth } from './useAuth';
[L:879] +
[L:880] +export function useRole() {
[L:881] +  const { user } = useAuth();
[L:882] +
[L:883] +  const roles = user?.roles || [];
[L:884] +  const isUser = roles.includes('user');
[L:885] +  const isAdmin = roles.includes('admin');
[L:886] +  const isSuperAdmin = roles.includes('super_admin');
[L:887] +
[L:888] +  const canAccessAdmin = isAdmin || isSuperAdmin;
[L:889] +  const canAccessSuperAdmin = isSuperAdmin;
[L:890] +
[L:891] +  return { roles, isUser, isAdmin, isSuperAdmin, canAccessAdmin, canAccessSuperAdmin };
[L:892] +}
[L:893] +
[L:894] +// Route protection:
[L:895] +// <Route path="/admin/*" element={canAccessAdmin ? <AdminLayout /> : <Navigate to="/" />} />
[L:896] +// <Route path="/admin/system" element={canAccessSuperAdmin ? <SystemPanel /> : <Navigate to="/admin" />} />
[L:897] +```
