[L:1] +import type { Candle, Overlay } from './types';
[L:2] +
[L:3] +export function normalizeCandles(candles: Candle[]): Candle[] {
[L:4] +  const byTime = new Map<number, Candle>();
[L:5] +  for (const candle of candles) {
[L:6] +    if (!Number.isFinite(candle.time) || !Number.isFinite(candle.open) || !Number.isFinite(candle.high) || !Number.isFinite(candle.low) || !Number.isFinite(candle.close) || !Number.isFinite(candle.volume)) continue;
[L:7] +    if (candle.high < candle.low || candle.open < candle.low || candle.open > candle.high || candle.close < candle.low || candle.close > candle.high) continue;
[L:8] +    byTime.set(Math.floor(candle.time), { ...candle, time: Math.floor(candle.time) });
[L:9] +  }
[L:10] +  return [...byTime.values()].sort((a, b) => a.time - b.time);
[L:11] +}
[L:12] +
[L:13] +export function normalizeOverlays(overlays: Overlay[], candles: Candle[]): Overlay[] {
[L:14] +  const first = candles[0]?.time;
[L:15] +  const last = candles[candles.length - 1]?.time;
[L:16] +  const result: Overlay[] = [];
[L:17] +  for (const overlay of overlays) {
[L:18] +    if (overlay.type === 'line') {
[L:19] +      const points = normalizePoints(overlay.points ?? []);
[L:20] +      if (points.length > 1) result.push({ ...overlay, points });
[L:21] +    } else if (overlay.type === 'hline') {
[L:22] +      if (Number.isFinite(overlay.price) && first !== undefined && last !== undefined) result.push({ ...overlay, price: overlay.price });
[L:23] +    } else if (overlay.type === 'markers') {
[L:24] +      const markers = (overlay.markers ?? []).filter((marker) => Number.isFinite(marker.time)).sort((a, b) => a.time - b.time);
[L:25] +      if (markers.length) result.push({ ...overlay, markers });
[L:26] +    }
[L:27] +  }
[L:28] +  return result;
[L:29] +}
[L:30] +
[L:31] +function normalizePoints(points: { time: number; value: number }[]): { time: number; value: number }[] {
[L:32] +  const byTime = new Map<number, { time: number; value: number }>();
[L:33] +  for (const point of points) {
[L:34] +    if (Number.isFinite(point.time) && Number.isFinite(point.value)) {
[L:35] +      byTime.set(Math.floor(point.time), { time: Math.floor(point.time), value: point.value });
[L:36] +    }
[L:37] +  }
[L:38] +  return [...byTime.values()].sort((a, b) => a.time - b.time);
[L:39] +}
