[L:653] +
[L:654] +## 5. The Scheduler & Queue System
[L:655] +
[L:656] +### 5.1 Why a Scheduler?
[L:657] +
[L:658] +In an autonomous system, decisions are not triggered by user clicks. They are triggered by:
[L:659] +- Time (candle closes)
[L:660] +- Events (liquidity sweep detected)
[L:661] +- Schedule (daily summary at 19:00 GMT)
[L:662] +
[L:663] +The scheduler manages all of this.
[L:664] +
[L:665] +### 5.2 Job Types
[L:666] +
[L:667] +```typescript
[L:668] +// apps/scheduler/src/jobs.ts
[L:669] +
[L:670] +interface ScheduledJob {
[L:671] +  id: string;
[L:672] +  type: 'candle_close' | 'interval' | 'event' | 'maintenance' | 'alert';
[L:673] +  symbol?: string;
[L:674] +  timeframe?: string;
[L:675] +  cron?: string;           // For recurring jobs
[L:676] +  eventType?: string;      // For event-driven jobs
[L:677] +  handler: () => Promise<void>;
[L:678] +  priority: number;        // 1 = critical, 10 = background
[L:679] +  retryPolicy: {
[L:680] +    maxRetries: number;
[L:681] +    backoff: 'linear' | 'exponential';
[L:682] +  };
[L:683] +}
[L:684] +
[L:685] +// Example jobs:
[L:686] +const jobs: ScheduledJob[] = [
[L:687] +  {
[L:688] +    id: 'eurusd-15m-pipeline',
[L:689] +    type: 'candle_close',
[L:690] +    symbol: 'EUR/USD',
[L:691] +    timeframe: '15m',
[L:692] +    handler: runDecisionPipeline,
[L:693] +    priority: 1,
[L:694] +    retryPolicy: { maxRetries: 3, backoff: 'exponential' }
[L:695] +  },
[L:696] +  {
[L:697] +    id: 'health-check',
[L:698] +    type: 'interval',
[L:699] +    cron: '*/30 * * * * *',  // Every 30 seconds
[L:700] +    handler: runHealthCheck,
[L:701] +    priority: 2,
[L:702] +    retryPolicy: { maxRetries: 5, backoff: 'linear' }
[L:703] +  },
[L:704] +  {
[L:705] +    id: 'daily-summary',
[L:706] +    type: 'maintenance',
[L:707] +    cron: '0 19 * * *',  // Every day at 19:00 GMT
[L:708] +    handler: sendDailySummary,
[L:709] +    priority: 5,
[L:710] +    retryPolicy: { maxRetries: 2, backoff: 'linear' }
[L:711] +  },
[L:712] +  {
[L:713] +    id: 'portfolio-snapshot',
[L:714] +    type: 'interval',
[L:715] +    cron: '*/5 * * * *',  // Every 5 minutes
[L:716] +    handler: takePortfolioSnapshot,
[L:717] +    priority: 3,
[L:718] +    retryPolicy: { maxRetries: 3, backoff: 'linear' }
[L:719] +  }
[L:720] +];
[L:721] +```
[L:722] +
[L:723] +### 5.3 Queue Management (BullMQ)
[L:724] +
[L:725] +BullMQ provides:
[L:726] +- **Job persistence** — If the system crashes, jobs are not lost
[L:727] +- **Priority queues** — Critical jobs (decisions) run before background jobs (snapshots)
[L:728] +- **Retry logic** — Failed jobs retry with backoff
[L:729] +- **Rate limiting** — Prevent overwhelming the API or data provider
[L:730] +- **Job progress** — Track long-running jobs (backtests, model training)
[L:731] +- **Dead letter queue** — Jobs that fail permanently are logged for investigation
[L:732] +
[L:733] +```
[L:734] +Queue: decisions (priority 1, max 10 concurrent)
[L:735] +Queue: positions (priority 2, max 5 concurrent)
[L:736] +Queue: alerts (priority 3, max 20 concurrent)
[L:737] +Queue: snapshots (priority 5, max 2 concurrent)
[L:738] +Queue: backtests (priority 5, max 1 concurrent)
[L:739] +Queue: ml_training (priority 5, max 1 concurrent)
[L:740] +```
[L:741] +
[L:742] +### 5.4 Watchdog
[L:743] +
[L:744] +The watchdog monitors system health:
[L:745] +
[L:746] +```typescript
[L:747] +// apps/scheduler/src/watchdog.ts
[L:748] +
[L:749] +class Watchdog {
[L:750] +  async check(): Promise<WatchdogResult> {
[L:751] +    const checks = await Promise.all([
[L:752] +      this.checkDataFreshness(),      // Is market data < 5 minutes old?
[L:753] +      this.checkApiHealth(),          // Is API responding?
[L:754] +      this.checkWsHealth(),           // Are WebSocket connections active?
[L:755] +      this.checkQueueHealth(),        // Are queues backing up?
[L:756] +      this.checkModelHealth(),        // Is ML model responding?
[L:757] +      this.checkDecisionLatency(),    // Are decisions taking < 2s?
[L:758] +    ]);
[L:759] +
[L:760] +    const failed = checks.filter(c => !c.passed);
[L:761] +    if (failed.length > 0) {
[L:762] +      await this.sendAlert('system_health', failed);
[L:763] +      if (failed.some(c => c.critical)) {
[L:764] +        await this.triggerCircuitBreaker('system_health_failure');
[L:765] +      }
[L:766] +    }
[L:767] +
[L:768] +    return { checks, healthy: failed.length === 0 };
[L:769] +  }
[L:770] +}
[L:771] +```
[L:772] +
