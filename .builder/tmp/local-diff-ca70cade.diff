index 0000000..92379db
--- /dev/null
+++ b/supabase/migrations/20261003030258_20261002000000_user_workspace_and_profile_rls.sql.sql
@@ -0,0 +1,179 @@
[L:1] +/*
[L:2] +# User Workspace Tables, Admin Function, and Profile RLS
[L:3] +
[L:4] +## Purpose
[L:5] +1. Create `is_current_user_admin()` SECURITY DEFINER function for admin checks.
[L:6] +2. Add admin-scoped RLS policies on profiles, cms_content, system_metrics.
[L:7] +3. Allow users to insert their own profile on signup.
[L:8] +4. Create `user_preferences` table (theme, notifications).
[L:9] +5. Create `user_watchlists` table (saved symbol lists).
[L:10] +6. Create `price_alerts` table (symbol/direction/target price alerts).
[L:11] +
[L:12] +## New Tables
[L:13] +- `user_preferences` — per-user theme + notification settings, PK = user_id
[L:14] +- `user_watchlists` — per-user watchlist with array of symbols, PK = user_id
[L:15] +- `price_alerts` — per-user price alerts with above/below triggers
[L:16] +
[L:17] +## Security
[L:18] +- `is_current_user_admin()` is SECURITY DEFINER, EXECUTE granted to authenticated only.
[L:19] +- Profiles: admin can read all + update any; users can insert their own (role='user' only).
[L:20] +- CMS: admin-only CRUD.
[L:21] +- System metrics: admin-only SELECT.
[L:22] +- User tables: owner-scoped with 4 separate CRUD policies (SELECT/INSERT/UPDATE/DELETE).
[L:23] +*/
[L:24] +
[L:25] +-- ============================================================
[L:26] +-- Admin check function
[L:27] +-- ============================================================
[L:28] +
[L:29] +CREATE OR REPLACE FUNCTION public.is_current_user_admin()
[L:30] +RETURNS boolean
[L:31] +LANGUAGE sql
[L:32] +STABLE
[L:33] +SECURITY DEFINER
[L:34] +SET search_path = public
[L:35] +AS $$
[L:36] +  SELECT EXISTS (
[L:37] +    SELECT 1 FROM public.profiles
[L:38] +    WHERE id = auth.uid() AND role = 'admin'
[L:39] +  );
[L:40] +$$;
[L:41] +
[L:42] +REVOKE ALL ON FUNCTION public.is_current_user_admin() FROM PUBLIC;
[L:43] +GRANT EXECUTE ON FUNCTION public.is_current_user_admin() TO authenticated;
[L:44] +
[L:45] +-- ============================================================
[L:46] +-- Profile RLS policies
[L:47] +-- ============================================================
[L:48] +
[L:49] +DROP POLICY IF EXISTS "select_all_profiles_admin" ON public.profiles;
[L:50] +CREATE POLICY "select_all_profiles_admin" ON public.profiles FOR SELECT
[L:51] +  TO authenticated USING (public.is_current_user_admin());
[L:52] +
[L:53] +DROP POLICY IF EXISTS "insert_own_profile" ON public.profiles;
[L:54] +CREATE POLICY "insert_own_profile" ON public.profiles FOR INSERT
[L:55] +  TO authenticated WITH CHECK (auth.uid() = id AND role = 'user');
[L:56] +
[L:57] +DROP POLICY IF EXISTS "update_any_profile_admin" ON public.profiles;
[L:58] +CREATE POLICY "update_any_profile_admin" ON public.profiles FOR UPDATE
[L:59] +  TO authenticated USING (public.is_current_user_admin())
[L:60] +  WITH CHECK (public.is_current_user_admin());
[L:61] +
[L:62] +-- ============================================================
[L:63] +-- CMS admin policies
[L:64] +-- ============================================================
[L:65] +
[L:66] +DROP POLICY IF EXISTS "read_all_cms_admin" ON public.cms_content;
[L:67] +CREATE POLICY "read_all_cms_admin" ON public.cms_content FOR SELECT
[L:68] +  TO authenticated USING (public.is_current_user_admin());
[L:69] +DROP POLICY IF EXISTS "insert_cms_admin" ON public.cms_content;
[L:70] +CREATE POLICY "insert_cms_admin" ON public.cms_content FOR INSERT
[L:71] +  TO authenticated WITH CHECK (public.is_current_user_admin());
[L:72] +DROP POLICY IF EXISTS "update_cms_admin" ON public.cms_content;
[L:73] +CREATE POLICY "update_cms_admin" ON public.cms_content FOR UPDATE
[L:74] +  TO authenticated USING (public.is_current_user_admin())
[L:75] +  WITH CHECK (public.is_current_user_admin());
[L:76] +DROP POLICY IF EXISTS "delete_cms_admin" ON public.cms_content;
[L:77] +CREATE POLICY "delete_cms_admin" ON public.cms_content FOR DELETE
[L:78] +  TO authenticated USING (public.is_current_user_admin());
[L:79] +
[L:80] +-- ============================================================
[L:81] +-- System metrics admin policy
[L:82] +-- ============================================================
[L:83] +
[L:84] +DROP POLICY IF EXISTS "read_system_metrics_admin" ON public.system_metrics;
[L:85] +CREATE POLICY "read_system_metrics_admin" ON public.system_metrics FOR SELECT
[L:86] +  TO authenticated USING (public.is_current_user_admin());
[L:87] +
[L:88] +-- ============================================================
[L:89] +-- user_preferences table
[L:90] +-- ============================================================
[L:91] +
[L:92] +CREATE TABLE IF NOT EXISTS public.user_preferences (
[L:93] +  user_id uuid PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,
[L:94] +  theme text NOT NULL DEFAULT 'dark' CHECK (theme IN ('light', 'dark')),
[L:95] +  notifications jsonb NOT NULL DEFAULT '{"marketAlerts":true,"news":false}'::jsonb,
[L:96] +  updated_at timestamptz NOT NULL DEFAULT now()
[L:97] +);
[L:98] +
[L:99] +ALTER TABLE public.user_preferences ENABLE ROW LEVEL SECURITY;
[L:100] +
[L:101] +DROP POLICY IF EXISTS "select_own_preferences" ON public.user_preferences;
[L:102] +CREATE POLICY "select_own_preferences" ON public.user_preferences FOR SELECT
[L:103] +  TO authenticated USING (auth.uid() = user_id);
[L:104] +
[L:105] +DROP POLICY IF EXISTS "insert_own_preferences" ON public.user_preferences;
[L:106] +CREATE POLICY "insert_own_preferences" ON public.user_preferences FOR INSERT
[L:107] +  TO authenticated WITH CHECK (auth.uid() = user_id);
[L:108] +
[L:109] +DROP POLICY IF EXISTS "update_own_preferences" ON public.user_preferences;
[L:110] +CREATE POLICY "update_own_preferences" ON public.user_preferences FOR UPDATE
[L:111] +  TO authenticated USING (auth.uid() = user_id) WITH CHECK (auth.uid() = user_id);
[L:112] +
[L:113] +DROP POLICY IF EXISTS "delete_own_preferences" ON public.user_preferences;
[L:114] +CREATE POLICY "delete_own_preferences" ON public.user_preferences FOR DELETE
[L:115] +  TO authenticated USING (auth.uid() = user_id);
[L:116] +
[L:117] +-- ============================================================
[L:118] +-- user_watchlists table
[L:119] +-- ============================================================
[L:120] +
[L:121] +CREATE TABLE IF NOT EXISTS public.user_watchlists (
[L:122] +  user_id uuid PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,
[L:123] +  name text NOT NULL DEFAULT 'Default Watchlist',
[L:124] +  symbols text[] NOT NULL DEFAULT '{}',
[L:125] +  updated_at timestamptz NOT NULL DEFAULT now()
[L:126] +);
[L:127] +
[L:128] +ALTER TABLE public.user_watchlists ENABLE ROW LEVEL SECURITY;
[L:129] +
[L:130] +DROP POLICY IF EXISTS "select_own_watchlist" ON public.user_watchlists;
[L:131] +CREATE POLICY "select_own_watchlist" ON public.user_watchlists FOR SELECT
[L:132] +  TO authenticated USING (auth.uid() = user_id);
[L:133] +
[L:134] +DROP POLICY IF EXISTS "insert_own_watchlist" ON public.user_watchlists;
[L:135] +CREATE POLICY "insert_own_watchlist" ON public.user_watchlists FOR INSERT
[L:136] +  TO authenticated WITH CHECK (auth.uid() = user_id);
[L:137] +
[L:138] +DROP POLICY IF EXISTS "update_own_watchlist" ON public.user_watchlists;
[L:139] +CREATE POLICY "update_own_watchlist" ON public.user_watchlists FOR UPDATE
[L:140] +  TO authenticated USING (auth.uid() = user_id) WITH CHECK (auth.uid() = user_id);
[L:141] +
[L:142] +DROP POLICY IF EXISTS "delete_own_watchlist" ON public.user_watchlists;
[L:143] +CREATE POLICY "delete_own_watchlist" ON public.user_watchlists FOR DELETE
[L:144] +  TO authenticated USING (auth.uid() = user_id);
[L:145] +
[L:146] +-- ============================================================
[L:147] +-- price_alerts table
[L:148] +-- ============================================================
[L:149] +
[L:150] +CREATE TABLE IF NOT EXISTS public.price_alerts (
[L:151] +  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
[L:152] +  user_id uuid NOT NULL DEFAULT auth.uid() REFERENCES auth.users(id) ON DELETE CASCADE,
[L:153] +  symbol text NOT NULL,
[L:154] +  direction text NOT NULL CHECK (direction IN ('above', 'below')),
[L:155] +  target_price numeric NOT NULL CHECK (target_price > 0),
[L:156] +  active boolean NOT NULL DEFAULT true,
[L:157] +  triggered_at timestamptz,
[L:158] +  created_at timestamptz NOT NULL DEFAULT now()
[L:159] +);
[L:160] +
[L:161] +CREATE INDEX IF NOT EXISTS idx_price_alerts_user_active ON public.price_alerts(user_id, active, created_at DESC);
[L:162] +
[L:163] +ALTER TABLE public.price_alerts ENABLE ROW LEVEL SECURITY;
[L:164] +
[L:165] +DROP POLICY IF EXISTS "select_own_price_alerts" ON public.price_alerts;
[L:166] +CREATE POLICY "select_own_price_alerts" ON public.price_alerts FOR SELECT
[L:167] +  TO authenticated USING (auth.uid() = user_id);
[L:168] +
[L:169] +DROP POLICY IF EXISTS "insert_own_price_alerts" ON public.price_alerts;
[L:170] +CREATE POLICY "insert_own_price_alerts" ON public.price_alerts FOR INSERT
[L:171] +  TO authenticated WITH CHECK (auth.uid() = user_id);
[L:172] +
[L:173] +DROP POLICY IF EXISTS "update_own_price_alerts" ON public.price_alerts;
[L:174] +CREATE POLICY "update_own_price_alerts" ON public.price_alerts FOR UPDATE
[L:175] +  TO authenticated USING (auth.uid() = user_id) WITH CHECK (auth.uid() = user_id);
[L:176] +
[L:177] +DROP POLICY IF EXISTS "delete_own_price_alerts" ON public.price_alerts;
[L:178] +CREATE POLICY "delete_own_price_alerts" ON public.price_alerts FOR DELETE
[L:179] +  TO authenticated USING (auth.uid() = user_id);
