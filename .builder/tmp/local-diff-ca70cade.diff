@@ -0,0 +1,22 @@
[L:1] +/*
[L:2] +# Grant Workspace Table Access
[L:3] +
[L:4] +## Purpose
[L:5] +Explicitly grant CRUD privileges on the workspace tables to the authenticated role.
[L:6] +These tables were created with RLS enabled but needed explicit grants for the
[L:7] +authenticated role to perform operations (RLS filters still apply on top of grants).
[L:8] +
[L:9] +## Tables Affected
[L:10] +- user_preferences — SELECT, INSERT, UPDATE, DELETE
[L:11] +- user_watchlists — SELECT, INSERT, UPDATE, DELETE
[L:12] +- price_alerts — SELECT, INSERT, UPDATE, DELETE
[L:13] +
[L:14] +## Security
[L:15] +- Grants give the authenticated role table-level privileges.
[L:16] +- RLS policies (added in the previous migration) enforce row-level ownership checks.
[L:17] +- Together: authenticated users can only see/modify their own rows.
[L:18] +*/
[L:19] +
[L:20] +GRANT SELECT, INSERT, UPDATE, DELETE ON public.user_preferences TO authenticated;
[L:21] +GRANT SELECT, INSERT, UPDATE, DELETE ON public.user_watchlists TO authenticated;
[L:22] +GRANT SELECT, INSERT, UPDATE, DELETE ON public.price_alerts TO authenticated;
[L:23/0] 
diff --git a/supabase/migrations/20261003030312_20261003000000_user_owned_paper_sim_accounts.sql.sql b/supabase/migrations/20261003030312_20261003000000_user_owned_paper_sim_accounts.sql.sql
