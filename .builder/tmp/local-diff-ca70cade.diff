index 0000000..3f3ed3a
--- /dev/null
+++ b/supabase/migrations/20261003030312_20261003000000_user_owned_paper_sim_accounts.sql.sql
@@ -0,0 +1,35 @@
[L:1] +/*
[L:2] +# Paper Sim Account User Ownership
[L:3] +
[L:4] +## Purpose
[L:5] +Fixes the `paper_sim_accounts` table so authenticated users can read and modify
[L:6] +their own paper trading account state. Previously the table had RLS enabled but
[L:7] +zero policies, making it accessible only via the service role key.
[L:8] +
[L:9] +## Changes
[L:10] +- REVOKE all from anon + authenticated (reset baseline).
[L:11] +- GRANT SELECT, INSERT, UPDATE to authenticated.
[L:12] +- Add 3 owner-scoped policies (SELECT, INSERT, UPDATE) keyed on account_id = auth.uid()::text.
[L:13] +  No DELETE policy — paper accounts should not be deletable by users.
[L:14] +
[L:15] +## Security
[L:16] +- Each user can only access the row where account_id matches their auth.uid().
[L:17] +- anon role has no access.
[L:18] +- DELETE is intentionally not granted — accounts are persistent.
[L:19] +*/
[L:20] +
[L:21] +REVOKE ALL ON public.paper_sim_accounts FROM anon, authenticated;
[L:22] +GRANT SELECT, INSERT, UPDATE ON public.paper_sim_accounts TO authenticated;
[L:23] +
[L:24] +DROP POLICY IF EXISTS "users_read_own_paper_sim_account" ON public.paper_sim_accounts;
[L:25] +CREATE POLICY "users_read_own_paper_sim_account" ON public.paper_sim_accounts FOR SELECT
[L:26] +  TO authenticated USING (account_id = auth.uid()::text);
[L:27] +
[L:28] +DROP POLICY IF EXISTS "users_create_own_paper_sim_account" ON public.paper_sim_accounts;
[L:29] +CREATE POLICY "users_create_own_paper_sim_account" ON public.paper_sim_accounts FOR INSERT
[L:30] +  TO authenticated WITH CHECK (account_id = auth.uid()::text);
[L:31] +
[L:32] +DROP POLICY IF EXISTS "users_update_own_paper_sim_account" ON public.paper_sim_accounts;
[L:33] +CREATE POLICY "users_update_own_paper_sim_account" ON public.paper_sim_accounts FOR UPDATE
[L:34] +  TO authenticated USING (account_id = auth.uid()::text)
[L:35] +  WITH CHECK (account_id = auth.uid()::text);
